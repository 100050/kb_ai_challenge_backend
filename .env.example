APP_ENV=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
MAX_HOUSING_PLANS=10

POSTGRES_DB=housing_ai
POSTGRES_USER=housing_ai
POSTGRES_PASSWORD=local_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://housing_ai:local_dev_password@localhost:5432/housing_ai

AI_PROVIDER=openai
AI_MODEL=
AI_API_KEY=

# 공공데이터포털: 법정동 코드와 전월세 실거래가 API 공통 인증키
DATA_GO_KR_API_KEY=

# 한국부동산원 R-ONE: 지역별 전월세전환율 API 인증키
R_ONE_API_KEY=

REAL_ESTATE_API_TIMEOUT_SECONDS=10
REAL_ESTATE_LOOKBACK_MONTHS=12
COMPARABLE_AREA_TOLERANCE_PERCENT=15

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
